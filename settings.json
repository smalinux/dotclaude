// ~/.claude/settings.json

// https://code.claude.com/docs/en/tools-reference

// how permission rules like `deny` work more broadly:
// https://code.claude.com/docs/en/permissions

===============================================================================
{
  "permissions": {
    "deny": [
      "EnterPlanMode",
      "ExitPlanMode",
      "DesignSync",
      "NotebookEdit",
      "SendMessage",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup",
      "AskUserQuestion",
      "CronCreate",
      "CronDelete",
      "CronList"
    ]
  },
  "statusLine": {
    "type": "command",
	"command": "/src/dotclaude/statusline.sh"
  },
  "disableBundledSkills": true,
  "disableWorkflows": true,
  "disableRemoteControl": true,
  "disableClaudeAiConnectors": true,
  "disableArtifact": true
}
